{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Configure a Debug build.",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Configure a Release build.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "quality",
      "displayName": "Quality",
      "description": "Configure the local quality build.",
      "binaryDir": "${sourceDir}/build/quality",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "mylib_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan UBSan",
      "description": "Configure a Debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "mylib_ENABLE_SANITIZERS": "ON",
        "mylib_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "description": "Configure a Debug build with ThreadSanitizer.",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "mylib_ENABLE_THREAD_SANITIZER": "ON",
        "mylib_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Configure a Debug build with gcov coverage instrumentation.",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "mylib_ENABLE_COVERAGE": "ON",
        "mylib_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Docs",
      "description": "Generate the API documentation with Doxygen; Doxygen warnings are errors.",
      "binaryDir": "${sourceDir}/build/docs",
      "cacheVariables": {
        "mylib_BUILD_DOCS": "ON",
        "mylib_BUILD_TESTS": "OFF",
        "mylib_INSTALL": "OFF",
        "mylib_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "quality",
      "displayName": "Quality",
      "configurePreset": "quality",
      "configuration": "Debug"
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan UBSan",
      "configurePreset": "asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "configurePreset": "tsan",
      "configuration": "Debug"
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "docs",
      "displayName": "Docs",
      "configurePreset": "docs",
      "targets": [
        "mylib_docs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "quality",
      "displayName": "Quality",
      "configurePreset": "quality",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan UBSan",
      "configurePreset": "asan-ubsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "configurePreset": "tsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
